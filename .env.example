# IncidentMind Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Settings
PROJECT_NAME="IncidentMind AI SRE"
ENVIRONMENT="development"
DEBUG=True

# Backend Server Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Hindsight by Vectorize API Configuration
# Option A: Hindsight Cloud API (Leave empty for fallback semantic engine)
HINDSIGHT_API_KEY=""
HINDSIGHT_BANK_ID="incidentmind_sre"
HINDSIGHT_BASE_URL="https://api.vectorize.io/hindsight/v1"

# Option B: Local Vector Engine Thresholds
SIMILARITY_THRESHOLD=0.70
TOP_K_RECALL=3

# Optional LLM Configuration (for optional augmented reasoning)
OPENAI_API_KEY=""
